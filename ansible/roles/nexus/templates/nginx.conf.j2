worker_processes auto;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 0;          # Nexus uploads / docker layers
    proxy_http_version 1.1;

    upstream nexus { server nexus:8081; keepalive 16; }

    # --- UI / API / Maven (nexus.lab) ---
    server {
        listen 80;
        server_name {{ nexus_all_server_names | join(' ') }};
        return 301 https://$host$request_uri;
    }
    server {
        listen 443 ssl;
        server_name {{ nexus_all_server_names | join(' ') }};

        ssl_certificate     /etc/nginx/certs/nexus.crt;
        ssl_certificate_key /etc/nginx/certs/nexus.key;

        location / {
            proxy_pass http://nexus;
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header Connection        "";
        }
    }

    # Per-registry vhosts (docker-registry, later maven-registry) — one file each.
    include /etc/nginx/conf.d/*.conf;
}
