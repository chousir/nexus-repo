# Generated by running the playbook locally (test-vars.yml) — certs, rendered
# nginx.conf/docker-compose.yml, conf.d/. Never commit generated TLS material.
ansible/.deploy/

# Transfer-bundle staging (image tarballs, offline pip wheels) — built fresh
# per nexus-airgap-verification.md's workflow, never tracked in the repo.
stage/
bundle/
*.tar
*.tar.gz
*.tar.gz.sha256

# TLS material — always self-signed and generated at deploy time.
*.crt
*.key
*.pem

# Ansible run logs (may echo task output, including secrets).
*.log

# Ansible retry files (disabled via ansible.cfg, kept as a defensive default).
*.retry

# Python virtualenvs (Appendix B's offline ansible-core install target).
.venv/
venv/
__pycache__/
*.pyc

# OS / editor cruft.
.DS_Store
*.swp
.vscode/
